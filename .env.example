# Render / produção
NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://SEU_USUARIO:SUA_SENHA@SEU_HOST/SEU_BANCO
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
CEO_INITIAL_PASSWORD=troque-esta-senha-antes-do-primeiro-deploy
